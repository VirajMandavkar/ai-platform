# ==============================================================================
# TriageHubs AI Assessment Platform - Environment Configuration
# ==============================================================================

# Database Driver: Supabase PostgreSQL
# You can find this connection string in:
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Recommended: Connection Pooling (Port 6543) or Direct (Port 5432)
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Master encryption key for AES-256-GCM API key protection (min 32 bytes)
ENCRYPTION_MASTER_KEY=triagehubs_secure_master_key_32

# Supabase Project API (Optional for direct SDK or Supabase Storage / Auth)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Server Ports
PORT=8081
PROXY_PORT=8080

# Note: If DATABASE_URL is not set or left empty, TriageHubs will automatically
# fallback to local SQLite (triagehubs.db) with zero setup required.
